# Supabase — public values only. These are safe to ship in the mobile bundle
# because all authorization is enforced by Row Level Security on the server.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Google OAuth — NO app-side environment variables are used.
# The provider is configured entirely server-side:
#   1. Supabase Dashboard → Authentication → Providers → Google
#   2. Google Cloud Console → OAuth client (Web application) whose secret
#      lives ONLY inside Supabase.
# See docs/AUTH_SETUP.md for the full checklist. Never place OAuth client
# secrets in this file or anywhere in the mobile app.

# SECURITY:
# - NEVER add EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY or any other secret here.
#   The service-role key bypasses RLS and must never exist in a mobile app.
# - Copy this file to `.env` (gitignored) and fill in real values.
